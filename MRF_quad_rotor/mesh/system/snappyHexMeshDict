FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    inlet
	{
		type triSurfaceMesh;
		file "inlet_large.stl";
	}
    outlet
	{
		type triSurfaceMesh;
		file "outlet_large.stl";
	}
    side
	{
		type triSurfaceMesh;
		file "side_large.stl";
	}
	blade_M1
	{
		type triSurfaceMesh;
		file "blade_M1.stl";
	}
	blade_M2
	{
		type triSurfaceMesh;
		file "blade_M2.stl";
	}
	blade_M3
	{
		type triSurfaceMesh;
		file "blade_M3.stl";
	}
	blade_M4
	{
		type triSurfaceMesh;
		file "blade_M4.stl";
	}
	MRF_M1
	 {
		 type searchableCylinder;
		 point1 (0.091 -0.087 -0.03);
		 point2 (0.091 -0.087 0.03);
		 radius 0.075;
	 }
	MRF_M2
	 {
		 type searchableCylinder;
		 point1 (-0.074 -0.087 -0.03);
		 point2 (-0.074 -0.087 0.03);
		 radius 0.075;
	 }
	MRF_M3
	 {
		 type searchableCylinder;
		 point1 (-0.074 0.087 -0.03);
		 point2 (-0.074 0.087 0.03);
		 radius 0.075;
	 }
	MRF_M4
	 {
		 type searchableCylinder;
		 point1 (0.091 0.087 -0.03);
		 point2 (0.091 0.087 0.03);
		 radius 0.075;
	 }
}

castellatedMeshControls
{
    maxLocalCells 100000;
    maxGlobalCells 8000000;
    minRefinementCells 5;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 2;

    features
    (
        { file "inlet.eMesh"; level 1;}
        { file "outlet.eMesh"; level 1;}
        { file "side.eMesh"; level 1;}
	{ file "blade_M1.eMesh"; level 4;}
	{ file "blade_M2.eMesh"; level 4;}
	{ file "blade_M3.eMesh"; level 4;}
	{ file "blade_M4.eMesh"; level 4;}
    );

    refinementSurfaces
    {
        inlet{ level (1 1);}
        outlet{ level (1 1);}
        side{ level (1 1);}
	blade_M1{ level (5 5);}
	blade_M2{ level (5 5);}
	blade_M3{ level (5 5);}
	blade_M4{ level (5 5);}
	MRF_M1
	    {
		level (1 1);
		cellZone cellMRFzone_M1;
		faceZone faceMRFzone_M1;
		cellZoneInside inside;
	    }
	MRF_M2
	    {
		level (1 1);
		cellZone cellMRFzone_M2;
		faceZone faceMRFzone_M2;
		cellZoneInside inside;
	    }
	MRF_M3
	    {
		level (1 1);
		cellZone cellMRFzone_M3;
		faceZone faceMRFzone_M3;
		cellZoneInside inside;
	    }
	MRF_M4
	    {
		level (1 1);
		cellZone cellMRFzone_M4;
		faceZone faceMRFzone_M4;
		cellZoneInside inside;
	    }
    }

    resolveFeatureAngle 4;

    refinementRegions
    {
		MRF_M1
		{
			mode inside;
			levels ((1000 1));

		}
		MRF_M2
		{
			mode inside;
			levels ((1000 1));

		}
		MRF_M3
		{
			mode inside;
			levels ((1000 1));

		}
		MRF_M4
		{
			mode inside;
			levels ((1000 1));

		}
    }

    locationInMesh (0.0 0.0 -0.4);
    allowFreeStandingZoneFaces false;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 4.0;
    nSolveIter 100; //300
    nRelaxIter 10;
    nFeatureSnapIter 20;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;

    layers
    {
	blade_M1
	{
		nSurfaceLayers 12;
	}
	blade_M2
	{
		nSurfaceLayers 12;
	}
	blade_M3
	{
		nSurfaceLayers 12;
	}
	blade_M4
	{
		nSurfaceLayers 12;
	}
    }

    expansionRatio 1.2;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 12;
    featureAngle 30;  // !
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 4;
    maxInternalSkewness 2;  // 1 volt
    maxConcave 80;
    minVol 1e-13;
    minTetQuality -1;
    minArea -1;
    minTwist 0.01;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
    relaxed
    {
        maxNonOrtho 75;
    }
}

mergeTolerance 1e-6;


// ************************************************************************* //
