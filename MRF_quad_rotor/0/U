FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 -5);  

boundaryField
{
    	inflow
    	{
		type            freestreamVelocity;
        	freestreamValue $internalField;
    	}

	outflow
	{
		type            freestreamVelocity;
        	freestreamValue $internalField;
	}

	sidee
	{
		type			symmetry;
	}

	blade_M1
	{
		type			noSlip;
	}

	blade_M2
	{
		type			noSlip;
	}

	blade_M3
	{
		type			noSlip;
	}

	blade_M4
	{
		type			noSlip;
	}

}


