FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver					GAMG;
        tolerance       		1e-5;
        relTol          		0.05;
		smoother				GaussSeidel;
		nCellsInCoarsestLevel	1400;
		cacheAgglomeration		true;
		agglomerator			faceAreaPair;
		mergeLevels				1;
    }

    U
    {
        solver			smoothSolver;
		smoother		GaussSeidel;
		nSweeps			2;
		tolerance		1e-5;
		relTol			0.1;
    }

    k
    {
        solver			smoothSolver;
        smoother        GaussSeidel;
		nSweeps			2;
        tolerance       1e-5;
        relTol          0.1;
    }

    omega
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
		nSweeps			2;
        tolerance       1e-5;
        relTol          0.1;
    }
	
}

SIMPLE
{
    nNonOrthogonalCorrectors 	0;
	pRefCell					0;
	pRefValue					0;
	residualControl
	{
		p						1e-5;
		U						1e-5;
		"(k|omega)"				1e-5;
	}
}

relaxationFactors
{
	fields
	{
		p			0.3;
	}
	equations
	{
		U			0.5;
		k			0.3;
		omega		0.3;
	}
}

