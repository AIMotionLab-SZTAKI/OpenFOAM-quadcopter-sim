FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      createNonConformalCouplesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Whether or not to add boundary conditions for the added patch to the fields
fields  no;

nonConformalCouples
{
	
	NCC_top
    {
        // Name of the two patches between which to create the coupling
        patches     (nonConfTop_rotor nonConfTop_stator);

        // Type of the transformation; "none", "rotational", or "translational"
        transform   none;
    }
	
	NCC_side
    {
        // Name of the two patches between which to create the coupling
        patches     (nonConfSide_rotor nonConfSide_stator);

        // Type of the transformation; "none", "rotational", or "translational"
        transform   none;
    }
	
	NCC_bottom
    {
        // Name of the two patches between which to create the coupling
        patches     (nonConfBottom_rotor nonConfBottom_stator);

        // Type of the transformation; "none", "rotational", or "translational"
        transform   none;
    }

}

