FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;

// Patches to create.
patches
(
    {
        // rotor-side patch
        name            NCC_inner;
        patchInfo
        {
            type            patch;
            matchTolerance  0.0001;
        }
        constructFrom patches;
        patches (wall-rotor);
    }

    {
        // stator-side patch
        name            NCC_outer;
        patchInfo
        {
            type            patch;
            matchTolerance  0.0001;
        }
        constructFrom patches;
        patches (wall-downflow wall-stator);
    }
	
);


