FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;

// Patches to create.
patches
(
    {
        // create combined outflow
        name            outflow;
        patchInfo
        {
            type            patch;
            matchTolerance  0.0001;
        }
        constructFrom patches;
        patches (outflow-downflow outflow-stator);
    }
	
);


