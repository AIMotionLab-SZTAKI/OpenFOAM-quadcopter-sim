forces
{
    type          forces;
    libs          (" libforces .so");

    writeControl  timeStep;
    timeInterval  1;

    patches       (blade);
    rho           rhoInf;     // Indicates incompressible
    log           true;
    rhoInf        1.205;          // Redundant for incompressible

    CofR          (0 0 0);    // Rotation around centre line of propeller
    pitchAxis     (0 0 1);
}


