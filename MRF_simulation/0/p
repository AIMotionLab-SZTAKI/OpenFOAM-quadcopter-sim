FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{

    inflow
    {
        type            zeroGradient;
    }
	
	outflow
	{
        type            fixedValue;
		value			uniform 0;
	}
	
	sidee
	{
		type			symmetry;
	}
	
	blade
	{
		type			zeroGradient;
	}

    cycTop_rot
    {
        type            cyclicAMI;
        value           $internalField;
    }
    cycSide_rot
    {
        type            cyclicAMI;
        value           $internalField;
    }
    cycBot_rot
    {
        type            cyclicAMI;
        value           $internalField;
    }
    cycTop_stat
    {
        type            cyclicAMI;
        value           $internalField;
    }
    cycSide_stat
    {
        type            cyclicAMI;
        value           $internalField;
    }
    cycBot_stat
    {
        type            cyclicAMI;
        value           $internalField;
    }



}


