FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{

    inflow
    {
        type            zeroGradient;
    }
	
	outflow-downflow
	{
        type            fixedValue;
		value			uniform 0;
	}
	
	outflow-stator
	{
        type            fixedValue;
		value			uniform 0;
	}
	
	side
	{
		type			symmetry;
	}
	
	blade
	{
		type			zeroGradient;
	}
	
	AMI1
	{
		type			cyclicAMI;
		value			$internalField;	}
	
	AMI2
	{
		type			cyclicAMI;
		value			$internalField;	}
}


