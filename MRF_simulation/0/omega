FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.0495;

boundaryField
{

    inflow
    {
        type            fixedValue;
		value			uniform 0.05;  //?????
    }
	
	outflow-downflow
	{
		type			zeroGradient;
	}
	
	outflow-stator
	{
		type			zeroGradient;
	}
	
	side
	{
		type			symmetry;
	}
	
	blade
	{
		type			omegaWallFunction;
		value			$internalField;
	}

	AMI1
	{
		type			cyclicAMI;
		value			$internalField;	}
	
	AMI2
	{
		type			cyclicAMI;
		value			$internalField;	}
}


