FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{

    inflow
    {
        type            fixedValue;
		value			uniform 1;
    }
	
	outflow-downflow
	{
		type			zeroGradient;
	}
	
	outflow-stator
	{
		type			zeroGradient;
	}
	
	side
	{
		type			symmetry;
	}
	
	blade
	{
		type			noSlip;
	}
	
	AMI1
	{
		type			cyclicAMI;
	}
	
	AMI2
	{
		type			cyclicAMI;
	}
}


