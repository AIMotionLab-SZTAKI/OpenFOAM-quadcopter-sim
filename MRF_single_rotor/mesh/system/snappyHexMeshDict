FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    inlet
	{
		type triSurfaceMesh;
		file "inlet_large.stl";
	}
    outlet
	{
		type triSurfaceMesh;
		file "outlet_large.stl";
	}
    side
	{
		type triSurfaceMesh;
		file "side_large.stl";
	}
	blade
	{
		type triSurfaceMesh;
		file "blade.stl";
	}
	MRF
	 {
		 type searchableCylinder;
		 point1 (0.0 0.0 -0.03);
		 point2 (0.0 0.0 0.03);
		 radius 0.095;
	 }
}

castellatedMeshControls
{
    maxLocalCells 100000;
    maxGlobalCells 8000000;
    minRefinementCells 5;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 2;

    features
    (
        { file "inlet_large.eMesh"; level 1;}
        { file "outlet_large.eMesh"; level 1;}
        { file "side_large.eMesh"; level 1;}
		{ file "blade.eMesh"; level 4;}
    );

    refinementSurfaces
    {
        inlet{ level (1 1);}
        outlet{ level (1 1);}
        side{ level (1 1);}
		blade{ level (5 5);}
		MRF
	    {
			level (1 1);
		    cellZone cellMRFzone;
		    faceZone faceMRFzone;
		    cellZoneInside inside;
	    }
    }

    resolveFeatureAngle 4;

    refinementRegions
    {
        // Note: for better mesh quality utilize this refinement region
		MRF
		{
			mode inside;
			levels ((1000 1)); //levels ((1E15 1));

		}
    }

    locationInMesh (0.0 0.0 -0.4);
    allowFreeStandingZoneFaces false;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 4.0;
    nSolveIter 100;
    nRelaxIter 10;
    nFeatureSnapIter 20;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;

    layers
    {
		blade
		{
			nSurfaceLayers 12;
		}
    }

    expansionRatio 1.2;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 12;
    featureAngle 30;
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 4;
    maxInternalSkewness 2;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality -1;
    minArea -1;
    minTwist 0.01;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
    relaxed
    {
        maxNonOrtho 75;
    }
}

mergeTolerance 1e-6;


