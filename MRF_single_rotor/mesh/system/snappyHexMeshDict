FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    inlet
	{
		type triSurfaceMesh;
		file "inlet.stl";
	}
    outlet
	{
		type triSurfaceMesh;
		file "outlet.stl";
	}
    side
	{
		type triSurfaceMesh;
		file "side.stl";
	}
	blade
	{
		type triSurfaceMesh;
		file "blade.stl";
	}
	MRF
	 {
		 type searchableCylinder;
		 point1 (0.0 0.0 -0.03);
		 point2 (0.0 0.0 0.03);
		 radius 0.095;
	 }
}

castellatedMeshControls
{
    maxLocalCells 100000;
    maxGlobalCells 8000000;
    minRefinementCells 0;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 2;

    features
    (
        { file "inlet.eMesh"; level 0;}
        { file "outlet.eMesh"; level 0;}
        { file "side.eMesh"; level 0;}
		{ file "blade.eMesh"; level 6;}
    );

    refinementSurfaces
    {
        inlet{ level (0 0);}
        outlet{ level (0 0);}
        side{ level (0 0);}
	blade{ level (6 6);}
	MRF
	    {
		level (0 0);
		    cellZone cellMRFzone;
		    faceZone faceMRFzone;
		    cellZoneInside inside;
	    }
    }

    resolveFeatureAngle 4;

    refinementRegions
    {
        // Note: for better mesh quality utilize this refinement region
		MRF
		{
			mode inside;
			levels ((1E15 1));
		}
    }

    locationInMesh (0.0 0.0 -0.4);
    allowFreeStandingZoneFaces false;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 4.0;
    nSolveIter 300;
    nRelaxIter 10;
    nFeatureSnapIter 20;
    implicitFeatureSnap true;
    explicitFeatureSnap false;
    multiRegionFeatureSnap true;
}

addLayersControls
{
    relativeSizes true;

    layers
    {
	blade.*
	{
		nSurfaceLayers 12;
	}
    }

    expansionRatio 1.2;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 12;
    featureAngle 30;  // !
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 4;
    maxInternalSkewness 1;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality -1;
    minArea -1;
    minTwist 0.01;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
    relaxed
    {
        maxNonOrtho 75;
    }
}

mergeTolerance 1e-6;


