FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

#includeEtc "caseDicts/setConstraintTypes"

boundaryField
{

    	inflow
    	{
		type            freestreamPressure;
        	freestreamValue $internalField;
        	//type            zeroGradient;
    	}
	
	outflow
	{
		type            freestreamPressure;
        	freestreamValue $internalField;
        	//type            fixedValue;
		//value			uniform 0;
	}
	
	sidee
	{
		type			symmetry;
	}
	
	blade
	{
		type			zeroGradient;
	}

}


